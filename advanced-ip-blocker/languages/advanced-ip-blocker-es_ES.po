msgid "Manage Honeypot URLs in the <a href=\"%s\">Blocking Rules</a> tab."
msgstr "Administre las URL de Honeypot en la pestaña <a href=\"%s\">Reglas de bloqueo</a>."

#: includes/class-advaipbl-settings-manager.php:556
