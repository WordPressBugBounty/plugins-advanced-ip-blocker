msgstr "Cuánto tiempo permanecerá activo el Desafío Global después de haberse activado automáticamente."

#: includes/class-advaipbl-settings-manager.php:655
msgid "Choose the type of JS challenge to serve during the Panic Mode."
msgstr "Elige el tipo de desafío JS que se mostrará durante el Modo Pánico."

#: includes/class-advaipbl-settings-manager.php:656
msgid "Emergency Email"
msgstr "Correo electrónico de emergencia"

#: includes/class-advaipbl-settings-manager.php:656
msgid "Leave empty to use the standard admin email."
msgstr "Déjelo en blanco para usar el correo electrónico de administrador estándar."

#: includes/class-advaipbl-settings-manager.php:659
msgid "Panic Alerts"
msgstr "Panic Alerts"

#: includes/class-advaipbl-settings-manager.php:666
msgid "Send Always (Email & Push)"
msgstr "Enviar siempre (Email & Push)"

#: includes/class-advaipbl-settings-manager.php:667
msgid "Send Push Only (No Email)"
msgstr "Solo envío de notificaciones push (sin email)"

#: includes/class-advaipbl-settings-manager.php:668
msgid "Disabled (Silent Mode)"
msgstr "Desactivado (modo silencioso)"

#: includes/class-advaipbl-settings-manager.php:671
msgid "Choose how you want to be notified when Auto-Panic triggers."
msgstr "Elige cómo quieres recibir notificaciones cuando se active la función de pánico automático."

#: includes/class-advaipbl-settings-manager.php:674
msgid "Panic Mode Exclusions"
msgstr "Exclusiones del modo pánico"

#: includes/class-advaipbl-settings-manager.php:674
msgid "Add one URI path or fragment per line (e.g., /wp-json/wc/v3/*). These URLs will NEVER be challenged during Panic Mode. Global Exclusions and WAF Exclusions are also automatically respected."
msgstr "Agregue una ruta o fragmento URI por línea (p. ej., /wp-json/wc/v3/*). Estas URL NUNCA serán cuestionadas durante el Modo Pánico. Las exclusiones globales y las exclusiones del WAF también se respetan automáticamente."

#: includes/class-advaipbl-settings-manager.php:679
msgid "Enable WAF"
msgstr "Habilitar WAF"

#: includes/class-advaipbl-settings-manager.php:685
msgid "Activate the WAF to scan requests against your custom rules."
msgstr "Active el WAF para escanear solicitudes según sus reglas personalizadas."

#. translators: %s is a placeholder
#: includes/class-advaipbl-settings-manager.php:686
#, php-format
msgid "Manage WAF rules in the <a href=\"%s\">Blocking Rules</a> tab."
msgstr "Administre las reglas de WAF en la pestaña <a href=\"%s\">Reglas de bloqueo</a>."

#: includes/class-advaipbl-settings-manager.php:690
msgid "Intelligent Zero-Day Sync"
msgstr "Intelligent Zero-Day Sync"

#: includes/class-advaipbl-settings-manager.php:690
msgid "Automatically download and apply critical WAF zero-day signatures from the AIB Central Server (Daily)."
msgstr "Descargar y aplicar automáticamente firmas críticas zero-day para WAF desde el servidor central de AIB (diariamente)."

#: includes/class-advaipbl-settings-manager.php:691
msgid "Cloud Advanced Rules Sync"
msgstr "Cloud Advanced Rules Sync"

#: includes/class-advaipbl-settings-manager.php:691
msgid "Automatically download and apply Advanced JSON Rules from the AIB Central Server."
msgstr "Descargue y aplique automáticamente las reglas JSON avanzadas desde el servidor central de AIB."

#: includes/class-advaipbl-settings-manager.php:692
msgid "WAF Block Duration (min)"
msgstr "Duración bloqueo WAF (min)"

#: includes/class-advaipbl-settings-manager.php:692
msgid "Duration to block IPs that trigger a WAF rule. Set to 0 for a permanent block."
msgstr "Duración para bloquear IP que activan una regla WAF. Se establece en 0 para un bloqueo permanente."

#: includes/class-advaipbl-settings-manager.php:693
msgid "Excluded URLs for WAF"
msgstr "URL excluidas para WAF"

#: includes/class-advaipbl-settings-manager.php:693
msgid "Add one URL fragment per line. Requests to URLs containing these strings will not be scanned by the WAF. Use this for payment gateway webhooks or problematic AJAX actions."
msgstr "Agregue un fragmento de URL por línea. El WAF no analizará las solicitudes a URL que contengan estas cadenas. Úselo para webhooks de pasarelas de pago o acciones AJAX problemáticas."

#: includes/class-advaipbl-settings-manager.php:698
msgid "Enable 404 Lockdown Mode"
msgstr "Habilitar modo 404 Lockdown"

#: includes/class-advaipbl-settings-manager.php:698
#: includes/class-advaipbl-settings-manager.php:714
