msgstr "Activar la protección contra ataques distribuidos"

#: includes/class-advaipbl-settings-manager.php:698
msgid "If enabled, a global \"Lockdown\" will be triggered when too many 404 errors occur from multiple IPs. During lockdown, ALL 404 visitors must solve a JS Challenge."
msgstr "Si está habilitado, se activará un bloqueo global cuando se produzcan demasiados errores 404 desde varias IP. Durante el bloqueo, todos los visitantes que reciban errores 404 deberán resolver un desafío de JavaScript."

#: includes/class-advaipbl-settings-manager.php:700
#: includes/class-advaipbl-settings-manager.php:716
msgid "Lockdown Trigger: Max Errors"
msgstr "Desencadenante Lockdown: Errores máximos"

#: includes/class-advaipbl-settings-manager.php:700
msgid "Total 404 errors allowed across the entire site..."
msgstr "Total de errores 404 permitidos en todo el sitio..."

#: includes/class-advaipbl-settings-manager.php:701
#: includes/class-advaipbl-settings-manager.php:717
msgid "Lockdown Trigger: Min Unique IPs"
msgstr "Umbral de IP único de Lockdown"

#: includes/class-advaipbl-settings-manager.php:701
#: includes/class-advaipbl-settings-manager.php:717
msgid "...originating from at least this many unique IPs..."
msgstr "...originados desde al menos esta cantidad de IP únicas..."

#: includes/class-advaipbl-settings-manager.php:702
#: includes/class-advaipbl-settings-manager.php:718
msgid "Lockdown Trigger: Time Window"
msgstr "Desencadenante Lockdown: Ventana de tiempo"

#: includes/class-advaipbl-settings-manager.php:702
#: includes/class-advaipbl-settings-manager.php:718
msgid "...within this many minutes."
msgstr "...en estos minutos."

#: includes/class-advaipbl-settings-manager.php:703
#: includes/class-advaipbl-settings-manager.php:719
#: includes/class-advaipbl-settings-manager.php:811
#: includes/class-advaipbl-settings-manager.php:883
msgid "Lockdown Duration (min)"
msgstr "Duración del Lockdown (min)"

#: includes/class-advaipbl-settings-manager.php:703
#: includes/class-advaipbl-settings-manager.php:719
