#, php-format
msgid "You can get your hCaptcha keys from the <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">hCaptcha Dashboard</a>."
msgstr "Puedes obtener tus claves de hCaptcha en el <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">panel de control de hCaptcha</a>."

#: includes/class-advaipbl-settings-manager.php:950
msgid "hCaptcha Secret Key"
msgstr "hCaptcha Secret Key"

#: includes/class-advaipbl-settings-manager.php:965
msgid "Enable Two-Factor Authentication"
msgstr "Habilitar la autenticación de dos factores"

#: includes/class-advaipbl-settings-manager.php:971
msgid "Enable the 2FA feature for all users on this site."
msgstr "Habilite la función 2FA para todos los usuarios de este sitio."

#. translators: %s is a placeholder
#: includes/class-advaipbl-settings-manager.php:972
#, php-format
msgid "When enabled, users will see the 2FA setup section in their  <a href=\"%s\">Profile</a>."
msgstr "Cuando esté habilitado, los usuarios verán la sección de configuración 2FA en su <a href=\"%s\">Perfil</a>."

#: includes/class-advaipbl-settings-manager.php:1028
msgid "Enable Htaccess Writer"
msgstr "Habilitar Htaccess Writer"

#: includes/class-advaipbl-settings-manager.php:1034
msgid "Allow the plugin to modify the .htaccess file."
msgstr "Permitir que el plugin modifique el archivo .htaccess."

#: includes/class-advaipbl-settings-manager.php:1021
msgid "This is required for all server-level blocking features. The plugin creates a backup before every write operation."
msgstr "Esto es necesario para todas las funciones de bloqueo a nivel de servidor. El plugin crea una copia de seguridad antes de cada operación de escritura."

#: includes/class-advaipbl-settings-manager.php:1043
msgid "Sync Blocked IPs"
msgstr "Sincronización de IPs bloqueadas"

#: includes/class-advaipbl-settings-manager.php:1049
msgid "Automatically write \"Manually Blocked\" and \"Permanent\" IPs to the .htaccess file."
msgstr "Escribir automáticamente las direcciones IP \"Bloqueadas manualmente\" y \"Permanentemente\" en el archivo .htaccess."

#: includes/class-advaipbl-settings-manager.php:1055
msgid "Include Temporary Blocks"
msgstr "Incluir bloqueos temporales"

#: includes/class-advaipbl-settings-manager.php:1061
msgid "Write ALL blocked IPs (including temporary ones like 404/Login) to .htaccess."
msgstr "Escriba TODAS las IP bloqueadas (incluidas las temporales como 404/Login) en .htaccess."

#: includes/class-advaipbl-settings-manager.php:1062
msgid "<strong>Advanced Performance:</strong> Offloads temporary blocks to the server. The file updates automatically when IPs expire. Requires \"Sync Blocked IPs\" to be enabled."
msgstr "<strong>Rendimiento avanzado:</strong> Descarga los bloqueos temporales al servidor. El archivo se actualiza automáticamente cuando caducan las direcciones IP. Requiere que esté habilitada la opción «Sincronizar direcciones IP bloqueadas»."

#: includes/class-advaipbl-settings-manager.php:1068
msgid "Block System Files"
msgstr "Bloquear archivos del sistema"

#: includes/class-advaipbl-settings-manager.php:1074
msgid "Block access to sensitive files (.git, .svn, .log, .sql, backups, etc.)"
msgstr "Bloquear el acceso a archivos confidenciales (.git, .svn, .log, .sql, copias de seguridad, etc.)"

#: includes/class-advaipbl-settings-manager.php:1080
msgid "Block wp-config.php"
msgstr "Bloquea wp-config.php"

#: includes/class-advaipbl-settings-manager.php:1086
msgid "Block direct access to wp-config.php and wp-config-sample.php"
msgstr "Bloquear el acceso directo a wp-config.php y wp-config-sample.php"

#: includes/class-advaipbl-settings-manager.php:1092
msgid "Block Readme Files"
msgstr "Bloquear Archivos Readme"

#: includes/class-advaipbl-settings-manager.php:1098
msgid "Block access to readme.html and license.txt (prevents version enumeration)"
msgstr "Bloquear el acceso a readme.html y license.txt (impide la enumeración de versiones)"

#: includes/class-advaipbl-settings-manager.php:1106
msgid "Enable Cloudflare Integration"
msgstr "Habilitar la integración de Cloudflare"

#: includes/class-advaipbl-settings-manager.php:1112
msgid "Activate synchronization with Cloudflare Firewall."
msgstr "Activar la sincronización con Cloudflare Firewall."

#: includes/class-advaipbl-settings-manager.php:1119
msgid "Cloudflare Safe-Guard"
msgstr "Cloudflare Safe-Guard"

#: includes/class-advaipbl-settings-manager.php:1125
msgid "Protect official Cloudflare infrastructure, CDN perimeter nodes, and internal scanners (e.g., CloudflareWebScanner) from being blacklisted by local WAF rules, User-Agent pattern matching, or Threat Scoring."
msgstr "Proteja la infraestructura oficial de Cloudflare, los nodos perimetrales de la CDN y los escáneres internos (p. ej., CloudflareWebScanner) para evitar que sean incluidos en listas negras por reglas locales de WAF, coincidencias de patrones de User-Agent o sistemas de puntuación de amenazas (Threat Scoring)."

#: includes/class-advaipbl-settings-manager.php:1131
msgid "Cloudflare API Token"
msgstr "Token de API de Cloudflare"

#. translators: %s is a placeholder
#: includes/class-advaipbl-settings-manager.php:1140
#, php-format
msgid "Create a token with <strong>Zone > Firewall > Edit</strong> permissions. <a href=\"%s\" target=\"_blank\">Get Token</a>"
msgstr "Crea un token con permisos de <strong>Zone > Firewall > Edit</strong>. <a href=\"%s\" target=\"_blank\">Obtener token</a>"

#: includes/class-advaipbl-settings-manager.php:1148
msgid "Zone ID"
msgstr "Zone ID"

#: includes/class-advaipbl-settings-manager.php:1155
msgid "Found on the \"Overview\" page of your domain in Cloudflare (bottom right)."
msgstr "Se encuentra en la página \"Descripción general\" de su dominio en Cloudflare (abajo a la derecha)."

#: includes/class-advaipbl-settings-manager.php:1161
msgid "Sync Manual Blocks"
msgstr "Sincronizar bloqueos manuales"

#: includes/class-advaipbl-settings-manager.php:1167
msgid "Push \"Manually Blocked\" IPs to Cloudflare."
msgstr "Envía direcciones IP \"bloqueadas manualmente\" a Cloudflare."

#: includes/class-advaipbl-settings-manager.php:1173
msgid "Sync Temporary Blocks"
msgstr "Sincronizar bloqueos temporales"

#: includes/class-advaipbl-settings-manager.php:1179
msgid "Push temporary blocks (WAF, Login attempts, etc.) to Cloudflare."
msgstr "Envía bloqueos temporales (WAF, intentos de inicio de sesión, etc.) a Cloudflare."

#: includes/class-advaipbl-settings-manager.php:1180
msgid "<strong>Recommended for High Security.</strong> Offload all bad traffic to the cloud."
msgstr "<strong>Recomendado para alta seguridad.</strong> Descargue todo el tráfico malo a la nube."

#: includes/class-advaipbl-settings-manager.php:1185
msgid "Check to delete all data from this plugin when it is deleted."
msgstr "Marcar para borrar todos los datos de este plugin cuando sea desinstalado ."

#: includes/class-advaipbl-settings-manager.php:1190
msgid "Enable Threat Scoring System"
msgstr "Habilitar el sistema de puntuación de amenazas"

#: includes/class-advaipbl-settings-manager.php:1196
msgid "Activate the dynamic IP threat scoring system."
msgstr "Activar el sistema dinámico de puntuación de amenazas de IP."

#: includes/class-advaipbl-settings-manager.php:1197
msgid "When enabled, the plugin will assign threat points to IPs for malicious actions instead of using simple thresholds. An IP will be blocked only when its total score reaches the configured threshold."
msgstr "Al habilitarse, el plugin asignará puntos de amenaza a las IP por acciones maliciosas en lugar de usar umbrales simples. Una IP se bloqueará solo cuando su puntuación total alcance el umbral configurado."

#: includes/class-advaipbl-settings-manager.php:1202
msgid "Blocking Threshold"
msgstr "Umbral de bloqueo"

#: includes/class-advaipbl-settings-manager.php:1205
msgid "An IP will be blocked when its threat score reaches or exceeds this value."
msgstr "Una IP se bloqueará cuando su puntuación de amenaza alcance o supere este valor."

#: includes/class-advaipbl-settings-manager.php:1211
msgid "How long an IP will be blocked after reaching the threshold. Set to 0 for a permanent block."
msgstr "Cuánto tiempo se bloqueará una IP tras alcanzar el límite. Se establece en 0 para un bloqueo permanente."

#: includes/class-advaipbl-settings-manager.php:1214
msgid "Threat Event Points"
msgstr "Puntos de eventos de amenaza"

#: includes/class-advaipbl-settings-manager.php:1216
msgid "Score Decay Rate"
msgstr "Tasa de caída de puntuación"

#: includes/class-advaipbl-settings-manager.php:1219
msgid "Number of points to subtract from an inactive IP's score during each decay cycle."
msgstr "Número de puntos a restar de la puntuación de una IP inactiva durante cada ciclo de decadencia."

#: includes/class-advaipbl-settings-manager.php:1222
msgid "Score Decay Frequency (Hours)"
msgstr "Frecuencia de caída de la puntuación (horas)"

#: includes/class-advaipbl-settings-manager.php:1225
msgid "How often (in hours) to run the decay process. The score of an IP will only decay if it has been inactive for at least this period."
msgstr "Frecuencia (en horas) con la que se ejecuta el proceso de decaimiento. La puntuación de una IP solo decaerá si ha estado inactiva durante al menos este periodo."

#: includes/class-advaipbl-settings-manager.php:1232
msgid "Enable Signature Logging"
msgstr "Habilitar el registro de firmas"

#: includes/class-advaipbl-settings-manager.php:1238
msgid "Activate the experimental request fingerprinting engine."
msgstr "Activa el motor experimental de huella digital de solicitudes."

#: includes/class-advaipbl-settings-manager.php:1239
msgid "<strong>Warning:</strong> This is an advanced feature for data collection. Activating it will log details of incoming requests to a new database table. Use only if you are aware of the potential performance impact on high-traffic sites."
msgstr "Advertencia: Esta es una función avanzada para la recopilación de datos. Al activarla, se registrarán los detalles de las solicitudes entrantes en una nueva tabla de la base de datos. Úsela solo si conoce el posible impacto en el rendimiento en sitios con mucho tráfico."

#: includes/class-advaipbl-settings-manager.php:1244
msgid "Enable Signature Analysis"
msgstr "Habilitar análisis de firma"

#: includes/class-advaipbl-settings-manager.php:1246
msgid "Activate automatic analysis of request signatures."
msgstr "Activar el análisis automático de las firmas de solicitud."

#: includes/class-advaipbl-settings-manager.php:1247
msgid "When enabled, a background process will analyze the collected logs to find patterns of a distributed attack."
msgstr "Cuando está habilitado, un proceso en segundo plano analizará los registros recopilados para encontrar patrones de un ataque distribuido."

#: includes/class-advaipbl-settings-manager.php:1250
msgid "Enable Signature Blocking"
msgstr "Habilitar bloqueo de firmas"

#: includes/class-advaipbl-settings-manager.php:1252
msgid "Activate blocking based on malicious signatures."
msgstr "Activar el bloqueo basado en firmas maliciosas."

#: includes/class-advaipbl-settings-manager.php:1253
msgid "<strong>Enable this to activate protection.</strong> When a request matches a known malicious signature, the plugin will present a JavaScript challenge to filter out bots."
msgstr "<strong>Habilite esto para activar la protección.</strong> Cuando una solicitud coincide con una firma maliciosa conocida, el complemento presentará un desafío de JavaScript para filtrar los bots."

#: includes/class-advaipbl-settings-manager.php:1258
msgid "Choose the type of JS challenge to serve when defending against distributed attacks."
msgstr "Seleccione el tipo de desafío JS que se utilizará para defenderse de ataques distribuidos."

#: includes/class-advaipbl-settings-manager.php:1261
msgid "Signature IP Threshold"
msgstr "Umbral de IP de firma"

#: includes/class-advaipbl-settings-manager.php:1264
msgid "The minimum number of different IPs that must use the same attack signature to be flagged as malicious."
msgstr "La cantidad mínima de IP diferentes que deben usar la misma firma de ataque para ser marcadas como maliciosas."

#: includes/class-advaipbl-settings-manager.php:1267
msgid "Analysis Window (Hours)"
msgstr "Ventana de análisis (horas)"

#: includes/class-advaipbl-settings-manager.php:1270
msgid "How far back (in hours) the analysis process should look for patterns."
msgstr "Hasta dónde (en horas) debe llegar el proceso de análisis para buscar patrones."

#: includes/class-advaipbl-settings-manager.php:1273
msgid "Signature Rule Lifetime (Hours)"
msgstr "Duración de la regla de firma (horas)"

#: includes/class-advaipbl-settings-manager.php:1276
msgid "How long a malicious signature will remain active before it expires."
msgstr "Cuánto tiempo permanecerá activa una firma maliciosa antes de caducar."

#: includes/class-advaipbl-settings-manager.php:1281
msgid "How often to send alerts for detected signatures."
msgstr "Con qué frecuencia enviar alertas para firmas detectadas."

#: includes/class-advaipbl-settings-manager.php:1284
msgid "Notification Recipient"
msgstr "Destinatario de la notificación"

#: includes/class-advaipbl-settings-manager.php:1286
msgid "Who should receive these specific alerts."
msgstr "Quién debe recibir estas alertas específicas."

#: includes/class-advaipbl-settings-manager.php:1289
msgid "Custom Recipient Email"
msgstr "Correo electrónico del destinatario personalizado"

#: includes/class-advaipbl-settings-manager.php:1292
msgid "Required if \"Custom Email\" is selected above."
msgstr "Obligatorio si se selecciona \"Correo electrónico personalizado\" arriba."

#: includes/class-advaipbl-settings-manager.php:1296
msgid "Trusted Signature Hashes"
msgstr "Hashes de firma confiables"

#: includes/class-advaipbl-settings-manager.php:1298
msgid "Add known legitimate signature hashes here (one per line). Requests matching these exact fingerprints will always be allowed and never logged by the Signature Engine. Use this for services like Googlebot, Facebook Crawler, etc., to prevent false positives. Find hashes in the \"Blocked Signatures\" page by clicking \"View Details\"."
msgstr "Agregue aquí hashes de firma legítimos conocidos (uno por línea). Las solicitudes que coincidan con estas huellas digitales exactas siempre se permitirán y el motor de firmas nunca las registrará. Úselo para servicios como Googlebot, Facebook Crawler, etc., para evitar falsos positivos. Encuentre los hashes en la página \"Firmas bloqueadas\" haciendo clic en \"Ver detalles\"."

#: includes/class-advaipbl-settings-manager.php:1306
msgid "Enable Activity Audit Log"
msgstr "Habilitar el registro de auditoría de actividad"

#: includes/class-advaipbl-settings-manager.php:1312
msgid "Record critical administrative actions."
msgstr "Registrar acciones administrativas críticas."

#: includes/class-advaipbl-settings-manager.php:1313
msgid "Logs plugin rule changes, setting updates, and other critical admin events to a separate audit table."
msgstr "Registra los cambios de reglas del plugin, las actualizaciones de configuración y otros eventos administrativos críticos en una tabla de auditoría separada."

#: includes/class-advaipbl-settings-manager.php:1319
msgid "Enable File Integrity Monitor"
msgstr "Habilitar el Monitor de Integridad de Archivos"

#: includes/class-advaipbl-settings-manager.php:1325
msgid "Monitor critical WordPress files for unauthorized changes."
msgstr "Supervise los archivos críticos de WordPress para detectar cambios no autorizados."

#: includes/class-advaipbl-settings-manager.php:1326
msgid "Automatically scans core files (wp-config.php, .htaccess, index.php) daily for modifications."
msgstr "Escanea automáticamente los archivos principales (wp-config.php, .htaccess, index.php) diariamente para detectar modificaciones."

#: includes/class-advaipbl-settings-manager.php:1332
msgid "Scan Uploads Directory"
msgstr "Escanear directorio de subidas"

#: includes/class-advaipbl-settings-manager.php:1338
msgid "Scan the wp-content/uploads directory for suspicious executable files (.php). Legitimate index.php files are safely ignored."
msgstr "Analice el directorio wp-content/uploads en busca de archivos ejecutables sospechosos (.php). Los archivos index.php legítimos se omiten de forma segura."

#: includes/class-advaipbl-settings-manager.php:1344
msgid "Enable Raw String Signatures"
msgstr "Habilitar firmas de cadenas Raw"

#: includes/class-advaipbl-settings-manager.php:1350
msgid "Detect malware using ultra-fast exact string matching."
msgstr "Detecte malware mediante la coincidencia exacta de cadenas ultrarrápida."

#: includes/class-advaipbl-settings-manager.php:1351
msgid "Recommended. This is the fastest and most common method for detecting known malware strings."
msgstr "Recomendado. Este es el método más rápido y común para detectar cadenas de malware conocidas."

#: includes/class-advaipbl-settings-manager.php:1357
msgid "Enable RegEx Signatures"
msgstr "Habilitar firmas RegEx"

#: includes/class-advaipbl-settings-manager.php:1363
msgid "Detect highly obfuscated malware using Regular Expressions."
msgstr "Detecta malware altamente ofuscado mediante expresiones regulares."

#: includes/class-advaipbl-settings-manager.php:1364
msgid "Advanced. Uses more CPU but detects polymorphic backdoors."
msgstr "Avanzado. Consume más CPU, pero detecta puertas traseras polimórficas."

#: includes/class-advaipbl-settings-manager.php:1386
msgid "Enable Domain Signatures"
msgstr "Habilitar firmas de dominio"

#: includes/class-advaipbl-settings-manager.php:1392
msgid "Detect malicious domains, APIs, and C2 servers inside files."
msgstr "Detecta dominios, API y servidores de comando y control (C2) maliciosos dentro de archivos."

#: includes/class-advaipbl-settings-manager.php:1393
msgid "Recommended. Very fast check for external malicious requests."
msgstr "Recomendado. Verificación muy rápida de solicitudes externas maliciosas."

#: includes/class-advaipbl-settings-manager.php:1399
msgid "Enable MD5 Hash Signatures"
msgstr "Habilitar firmas hash MD5"

#: includes/class-advaipbl-settings-manager.php:1405
msgid "Identify known malware files instantly using MD5 hashes."
msgstr "Identifique archivos de malware conocidos al instante mediante hashes MD5."

#: includes/class-advaipbl-settings-manager.php:1406
msgid "Recommended. Skips reading file contents if the hash matches known malware."
msgstr "Recomendado. Omite la lectura del contenido del archivo si el hash coincide con malware conocido."

#: includes/class-advaipbl-settings-manager.php:1412
msgid "Enable SHA256 Hash Signatures"
msgstr "Habilitar firmas hash SHA256"

#: includes/class-advaipbl-settings-manager.php:1418
msgid "Identify known malware files using SHA256 hashes."
msgstr "Identifique archivos de malware conocidos mediante hashes SHA256."

#: includes/class-advaipbl-settings-manager.php:1419
msgid "Slower than MD5 but highly accurate."
msgstr "Más lento que MD5 pero altamente preciso."

#: includes/class-advaipbl-settings-manager.php:1425
msgid "Excluded Paths for FIM"
msgstr "Rutas excluidas para FIM"

#: includes/class-advaipbl-settings-manager.php:1431
msgid "Add one path fragment per line. If a scanned file's path contains any of these strings, it will be ignored by the FIM. Example: <code>wp-content/uploads/cache/</code>"
msgstr "Añada un fragmento de ruta por línea. Si la ruta de un archivo escaneado contiene alguna de estas cadenas, el FIM la ignorará. Ejemplo: <code>wp-content/uploads/cache/</code>"

#: includes/class-advaipbl-settings-manager.php:1437
msgid "FIM Alert Email"
msgstr "Correo electrónico de alerta FIM"

#: includes/class-advaipbl-settings-manager.php:1443
msgid "Where to send critical file change alerts (leave blank for admin email)."
msgstr "Dónde enviar alertas de cambios críticos de archivos (déjelo en blanco para el correo electrónico del administrador)."

#: includes/class-advaipbl-settings-manager.php:1456
msgid "Daily (Recommended)"
msgstr "Diariamente (recomendado)"

#: includes/class-advaipbl-settings-manager.php:1457
msgid "Twice a day (Every 12 hours)"
msgstr "Dos veces al día (cada 12 horas)"

#: includes/class-advaipbl-settings-manager.php:1458
msgid "High Security (Every 6 hours - Warning: Consumes more resources)"
msgstr "Alta seguridad (Cada 6 horas - Advertencia: consume más recursos)"

#: includes/class-advaipbl-settings-manager.php:1465
msgid "Manual Scan"
msgstr "Escaneo manual"

#: includes/class-advaipbl-settings-manager.php:1624
msgid "Invalid AIB Cloud Network Token. Connection failed."
msgstr "Token de red AIB Cloud no válido. Error de conexión."

#: includes/class-advaipbl-settings-manager.php:1846
msgid "No advanced rules defined. Global limits will apply."
msgstr "No se han definido reglas avanzadas. Se aplicarán los límites globales."

#: includes/class-advaipbl-settings-manager.php:1927
msgid "Protected"
msgstr "Protegido"

#: includes/class-advaipbl-settings-manager.php:2043
msgid "Quick Add CDN/Proxy:"
msgstr "Agregar rápidamente CDN/Proxy:"

#: includes/class-advaipbl-settings-manager.php:2049
#: includes/class-advaipbl-settings-manager.php:2078
msgid "Add to List"
msgstr "Añadir a la lista"

#: includes/class-advaipbl-settings-manager.php:2050
msgid "Select a service to automatically append its known IP ranges/ASNs to your trusted list."
msgstr "Select a service to automatically append its known IP ranges/ASNs to your trusted list."

#: includes/class-advaipbl-settings-manager.php:2075
msgid "Added!"
msgstr "¡Agregado!"

#: includes/class-advaipbl-settings-manager.php:2081
msgid "This preset is already in your list."
msgstr "Este ajuste preestablecido ya está en tu lista."

#: includes/class-advaipbl-settings-manager.php:2144
msgid "Select the timezone to display in the logs."
msgstr "Selecciona la zona horaria para mostrar en los logs."

#: includes/class-advaipbl-settings-manager.php:2152
msgid "Instant"
msgstr "Instantáneo"

#: includes/class-advaipbl-settings-manager.php:2153
msgid "Daily Summary"
msgstr "Resumen Diario"

#: includes/class-advaipbl-settings-manager.php:2154
msgid "Weekly Summary"
msgstr "Resumen Semanal"

#: includes/class-advaipbl-settings-manager.php:2168
msgid "Choose how often you want to receive alert emails."
msgstr "Elige con qué frecuencia quieres recibir los emails de alerta."

#: includes/class-advaipbl-settings-manager.php:2175
msgid "Instant (Batch per hour)"
msgstr "Instantáneo (lotes por hora)"

#: includes/class-advaipbl-settings-manager.php:2176
