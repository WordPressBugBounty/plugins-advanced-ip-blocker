#: includes/class-advaipbl-settings-manager.php:2149
msgid "Failed Login"
msgstr "Inicio de sesión fallido"

#: includes/class-advaipbl-settings-manager.php:2150
msgid "Blocked User-Agent"
msgstr "User-Agent Bloqueado"

#: includes/class-advaipbl-settings-manager.php:2151
