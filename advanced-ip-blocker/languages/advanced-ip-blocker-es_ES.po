msgstr "Puedes obtener tus claves de Turnstile en el <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">panel de control de Cloudflare</a>."

#: includes/class-advaipbl-settings-manager.php:935
msgid "Turnstile Secret Key"
msgstr "Turnstile Secret Key"

#: includes/class-advaipbl-settings-manager.php:941
