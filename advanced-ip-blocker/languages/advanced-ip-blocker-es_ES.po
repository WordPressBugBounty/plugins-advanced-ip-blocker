msgstr ""
"No se han definido reglas avanzadas. Se aplicarán los límites globales."

#: includes/class-advaipbl-settings-manager.php:1817
msgid "Protected"
msgstr "Protegido"

#: includes/class-advaipbl-settings-manager.php:1925
msgid "Quick Add CDN/Proxy:"
msgstr "Agregar rápidamente CDN/Proxy:"

#: includes/class-advaipbl-settings-manager.php:1931
#: includes/class-advaipbl-settings-manager.php:1960
