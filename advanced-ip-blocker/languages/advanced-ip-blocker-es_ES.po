#. translators: %s is a placeholder
#: includes/class-advaipbl-admin-pages.php:1173
#, php-format
msgid ""
"AbuseIPDB is a crowdsourced database of IPs that have been reported for "
"malicious activity. This feature checks new visitors against the database "
"and blocks them if their abuse score is too high. A <a href=\"%s\" "
"target=\"_blank\">free API key</a> is required."
msgstr ""
"AbuseIPDB es una base de datos colaborativa de direcciones IP reportadas por "
"actividad maliciosa. Esta función verifica a los nuevos visitantes "
"comparándolos con la base de datos y los bloquea si su puntuación de abuso "
