msgstr ""
"Obtenga una clave API gratuita a continuación para conectar su sitio a la "
"red en la nube de AIB."

#: includes/class-advaipbl-settings-manager.php:2235
msgid "Connected"
msgstr "Conectado"

#: includes/class-advaipbl-settings-manager.php:2237
msgid "AIB Cloud Network"
msgstr "Red en la nube de AIB"

#: includes/class-advaipbl-settings-manager.php:2240
msgid "Verify Connection"
msgstr "Verificar conexión"

#: includes/class-advaipbl-settings-manager.php:2271
msgid "Edit API Key"
msgstr "Editar clave de API"

#: includes/class-advaipbl-settings-manager.php:2275
msgid "Get a Free VIP Key instantly"
msgstr "Obtén una clave VIP gratuita al instante"

#: includes/class-advaipbl-settings-manager.php:2275
msgid "Get Free Key"
msgstr "Obtener clave gratis"

#: includes/class-advaipbl-settings-manager.php:2284
msgid "Your API key is hidden for security."
msgstr "Tu clave de API está oculta por seguridad."

#: includes/class-advaipbl-settings-manager.php:2312
msgid "Invalid API Key format. It should start with AIB_."
msgstr "Formato de clave de API no válido. Debe comenzar con AIB_."

#: includes/class-advaipbl-settings-manager.php:2332
